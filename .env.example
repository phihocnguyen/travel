# Signed session cookie. Use a long random string in production.
AUTH_SECRET=

# PostgreSQL / Neon. Keep the real credentials in .env.local (never commit them).
DATABASE_URL=

# Google OAuth is required in development and production. Demo sign-in is removed.

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override when the public origin differs from the request origin.
GOOGLE_REDIRECT_URI=

# Comma-separated emails allowed to review and approve blog posts.
ADMIN_EMAILS=
