# Signed session cookie. Use a long random string in production.
AUTH_SECRET=

# Temporary: skip Google/credential checks and open a demo session.
# Set to 1 only for local development.
AUTH_BYPASS=

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override when the public origin differs from the request origin.
GOOGLE_REDIRECT_URI=

# Optional email/password account used by the login form.
AUTH_DEMO_EMAIL=
AUTH_DEMO_PASSWORD=

# Comma-separated emails allowed to review and approve blog posts.
ADMIN_EMAILS=
