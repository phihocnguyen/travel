# Signed session cookie. Use a long random string in production.
AUTH_SECRET=

# PostgreSQL / Neon. Keep the real credentials in .env.local (never commit them).
DATABASE_URL=

# Members sign in with Google. Administrators can also use credentials.

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override when the public origin differs from the request origin.
GOOGLE_REDIRECT_URI=

# Comma-separated emails allowed to review and approve blog posts.
ADMIN_EMAILS=

# Uploaded images on persistent disk. Defaults to .data/uploads locally.
IMAGE_STORAGE_DIR=.data/uploads
